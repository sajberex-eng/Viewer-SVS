# Адрес сервера берётся из .env, поэтому IP-адрес не попадает в репозиторий.
{
	# При обращении по IP-адресу клиент не сообщает имя сервера, и без этой
	# строки Caddy не знает, какой сертификат подать, и обрывает соединение.
	default_sni {$VIEWER_HOST}
}

https://{$VIEWER_HOST} {
	encode gzip

	# Сертификат на IP-адрес Let's Encrypt выдаёт только коротким профилем
	# (действует около недели, Caddy продлевает сам через порт 80). Проверка
	# по TLS-ALPN для IP не работает, поэтому остаётся только проверка по HTTP.
	# Для доменного имени профиль и отключение проверки можно убрать.
	tls {
		issuer acme {
			profile shortlived
			disable_tlsalpn_challenge
		}
	}

	# Сканы загружаются частями по 8 МБ; запас на служебные заголовки
	request_body {
		max_size 32MB
	}

	reverse_proxy viewer:8000 {
		# Чтение большого тела и ответ на медленном канале не должны обрываться
		transport http {
			read_timeout 10m
			write_timeout 10m
		}
	}

	header {
		# Сервис работает только по HTTPS
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
